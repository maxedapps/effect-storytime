{
	"name": "effect-storytime",
	"version": "0.1.0",
	"private": true,
	"description": "Effect-native story testing: pure state machines whose side effects are Schema data, told and checked as strict stories.",
	"files": [
		"dist"
	],
	"type": "module",
	"exports": {
		".": "./dist/index.js",
		"./Decider": "./dist/Decider.js",
		"./Decision": "./dist/Decision.js",
		"./Exploration": "./dist/Exploration.js",
		"./Loop": "./dist/Loop.js",
		"./Program": "./dist/Program.js",
		"./Story": "./dist/Story.js",
		"./Tale": "./dist/Tale.js",
		"./StoryRecord": "./dist/StoryRecord.js",
		"./reporter": "./dist/reporter.js",
		"./vitest": "./dist/vitest.js"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"check": "oxfmt --check && oxlint && tsc && vitest run --coverage && stryker run && pnpm build",
		"format": "oxfmt",
		"lint": "oxlint",
		"mutate": "stryker run",
		"prepare": "effect-tsgo patch --typescript --oxlint",
		"release": "node scripts/release.ts",
		"test": "vitest run --coverage",
		"typecheck": "tsc"
	},
	"devDependencies": {
		"@effect/tsgo": "catalog:",
		"@effect/vitest": "catalog:",
		"@oxlint/plugins": "catalog:",
		"@stryker-mutator/core": "catalog:",
		"@stryker-mutator/vitest-runner": "catalog:",
		"@types/node": "catalog:",
		"@vitest/coverage-v8": "catalog:",
		"effect": "catalog:",
		"oxfmt": "catalog:",
		"oxlint": "catalog:",
		"oxlint-tsgolint": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"peerDependencies": {
		"@effect/vitest": "^4.1.2",
		"effect": "^4.1.2",
		"vitest": "^5.1.0"
	},
	"peerDependenciesMeta": {
		"@effect/vitest": {
			"optional": true
		},
		"vitest": {
			"optional": true
		}
	}
}

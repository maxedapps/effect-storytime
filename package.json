{
	"name": "effect-storytime",
	"version": "0.3.0",
	"description": "Lean domain modelling for Effect 4: Deciders and Programs as pure state machines, told and checked as strict stories.",
	"keywords": [
		"ddd",
		"decider",
		"domain-driven-design",
		"effect",
		"effect-ts",
		"property-based-testing",
		"schema",
		"state-machine",
		"stories",
		"testing",
		"vitest"
	],
	"homepage": "https://github.com/maxedapps/effect-storytime#readme",
	"bugs": "https://github.com/maxedapps/effect-storytime/issues",
	"license": "MIT",
	"author": "Maximilian Schwarzmüller",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/maxedapps/effect-storytime.git"
	},
	"files": [
		"dist",
		"src"
	],
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": "./dist/index.js",
		"./testing": "./dist/testing/index.js"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"check": "oxfmt --check && oxlint && tsc && vitest run --coverage && stryker run && pnpm build",
		"format": "oxfmt",
		"lint": "oxlint",
		"mutate": "stryker run",
		"prepare": "effect-tsgo patch --typescript --oxlint",
		"test": "vitest run --coverage",
		"typecheck": "tsc"
	},
	"devDependencies": {
		"@effect/tsgo": "catalog:",
		"@effect/vitest": "catalog:",
		"@oxlint/plugins": "catalog:",
		"@stryker-mutator/core": "catalog:",
		"@stryker-mutator/vitest-runner": "catalog:",
		"@types/node": "catalog:",
		"@vitest/coverage-v8": "catalog:",
		"effect": "catalog:",
		"oxfmt": "catalog:",
		"oxlint": "catalog:",
		"oxlint-tsgolint": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"peerDependencies": {
		"@effect/vitest": "^4.1.2",
		"effect": "^4.1.2",
		"vitest": "^5.1.0"
	},
	"peerDependenciesMeta": {
		"@effect/vitest": {
			"optional": true
		},
		"vitest": {
			"optional": true
		}
	},
	"engines": {
		"node": ">=22.12.0"
	},
	"packageManager": "pnpm@12.15.0"
}
